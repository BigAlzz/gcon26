HOST=127.0.0.1
PORT=4000
GCON_AUTH_MODE=demo
# Set to an external identity mode in deployed environments. Demo bearer tokens
# are rejected unless GCON_AUTH_MODE is exactly "demo".
GCON_LOCAL_ENCRYPTION_KEY=change-me-in-development

# Production bindings - do not commit secrets.
DATABASE_URL=postgresql://user:password@host:5432/gcon
AZURE_STORAGE_CONNECTION_STRING=
AZURE_KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=
