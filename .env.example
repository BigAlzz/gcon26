HOST=127.0.0.1
PORT=4000
GCON_AUTH_MODE=demo
# Set to an external identity mode in deployed environments. Demo bearer tokens
# are rejected unless GCON_AUTH_MODE is exactly "demo".
GCON_LOCAL_ENCRYPTION_KEY=change-me-in-development

# Production bindings - do not commit secrets.
# Leave GCON_DATABASE_PROVIDER as local for encrypted local development.
# Set it to sqlserver and inject the connection string through the approved
# secret manager in deployed environments.
GCON_DATABASE_PROVIDER=local
MSSQL_CONNECTION_STRING=Server=localhost;Database=GCON;User Id=gcon_app;Password=change-me;Encrypt=True;TrustServerCertificate=False;
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_AUTO_MIGRATE=true
MSSQL_POOL_MAX=10
MSSQL_POOL_MIN=0
MSSQL_REQUEST_TIMEOUT_MS=30000
MSSQL_CONNECTION_TIMEOUT_MS=15000
MSSQL_APP_NAME=gcon-2027-api

# Legacy placeholder retained for teams that use a separate adapter.
DATABASE_URL=postgresql://user:password@host:5432/gcon
AZURE_STORAGE_CONNECTION_STRING=
AZURE_KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=
